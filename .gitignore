# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Hardhat / Blockchain
artifacts/
cache/
typechain-types/
blockchain/circuits/build/
# Auto-synced from circuits/build/ by verifiers:sync — must match the gitignored
# .zkey, so never committed; regenerate via circuits:setup
blockchain/contracts/verifiers/*.sol
# Throwaway local deployments (chain resets, addresses are deterministic).
# deployments/sepolia.json IS committed — it is the record of the live demo.
blockchain/deployments/hardhat.json
blockchain/deployments/localhost.json
blockchain/ptau/*.ptau
coverage/
coverage.json

# Generated OpenAPI spec — regenerate with `pnpm --filter backend run openapi:export`
# (changes on every DTO edit, so keeping it in git would be pure churn)
web-app/backend/openapi.json

# Issuer X.509 identity (Phase 5, D30) — issuer.key.pem is private key material.
# Regenerate with `pnpm --filter backend run cert:generate`.
web-app/backend/certs/

# Mock data fixtures (Phase 0) — regenerated via `pnpm --filter blockchain run mock:generate`;
# mockSecrets.json holds ownerSecret private key material, never commit it.
blockchain/fixtures/

# Next.js
.next/
out/

# NestJS / Build output
dist/
build/

# Prisma
# (keep schema.prisma, but ignore generated client if desired)
