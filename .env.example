# ============================================================
# Land Registry ZKP — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# -------------------------------------------------------
# Blockchain (Hardhat + deploy scripts)
# -------------------------------------------------------

# Alchemy / Infura RPC URL for Sepolia testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Private key of the deployer wallet (no 0x prefix needed by ethers, but include it to be safe)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Etherscan API key — only needed for `npx hardhat verify` (source verification)
# after a Sepolia deploy. Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# State authority account granted STATE_AUTHORITY_ROLE at deploy (default: the deployer)
AUTHORITY_ADDRESS=

# Account granted ATTESTER_ROLE at deploy (D82) — the address of ATTESTER_PRIVATE_KEY below.
# Defaults to Hardhat account #1 on a local network; REQUIRED on Sepolia.
ATTESTER_ADDRESS=

# X.509 Subject "O" (organization name) anchored on-chain for the authority (D30).
# Must match the self-signed certificate used by the verifier portal (Phase 9).
AUTHORITY_ORG_NAME="So Tai nguyen va Moi truong TP.HCM"

# -------------------------------------------------------
# Database (PostgreSQL via Docker — host port 5433)
# Port 5433 is used to avoid conflict with other local projects on 5432
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/land_registry?schema=public"

# -------------------------------------------------------
# Backend — Government Portal API (Phase 5)
# These belong in web-app/backend/.env — that is the file the backend loads
# when started with `pnpm run dev:backend`.
# -------------------------------------------------------

# Which blockchain/deployments/<network>.json the backend reads addresses from
CHAIN_NETWORK=localhost

# JSON-RPC endpoint. Defaults to http://127.0.0.1:8545 for localhost, and to
# SEPOLIA_RPC_URL when CHAIN_NETWORK=sepolia.
RPC_URL=http://127.0.0.1:8545

# Signer for publishRoot(). MUST be an account registered through
# registerAuthority(), otherwise every publish reverts. Falls back to
# PRIVATE_KEY when unset. Hardhat account #0 (a public test key) for local dev:
AUTHORITY_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Key the backend signs status attestations with (D82) — NOT the authority key: it can vouch
# "no open procedure" but cannot publish roots. Defaults to Hardhat account #1 (a public test
# key) on a local network; REQUIRED on Sepolia, and must match ATTESTER_ADDRESS above.
ATTESTER_PRIVATE_KEY=

# Static API key guarding the government endpoints (D14 — the state authority
# is mocked for the PoC). Sent by clients as the x-gov-api-key header.
GOV_API_KEY=dev-gov-key-change-me

# Issuer X.509 identity (D30/D31). Created by
# `pnpm --filter backend run cert:generate`; defaults to web-app/backend/certs/.
ISSUER_CERT_PATH=
ISSUER_KEY_PATH=

# Swagger UI at /api/docs. On by default in development; off when
# NODE_ENV=production unless this is set to 1 — the page lists the state
# authority's endpoints, so it should not be public by default.
ENABLE_SWAGGER=

# -------------------------------------------------------
# Frontend (Next.js public env vars — exposed to browser)
# -------------------------------------------------------

# Deployed RootRegistry contract address (fill after deploy)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# WalletConnect Project ID — get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
