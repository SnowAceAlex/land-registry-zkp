# ============================================================
# Land Registry ZKP — Environment Variables Example
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# -------------------------------------------------------
# Blockchain (Hardhat + deploy scripts)
# -------------------------------------------------------

# Alchemy / Infura RPC URL for Sepolia testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Private key of the deployer wallet (no 0x prefix needed by ethers, but include it to be safe)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Etherscan API key — only needed for `npx hardhat verify` (source verification)
# after a Sepolia deploy. Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# State authority account granted STATE_AUTHORITY_ROLE at deploy (default: the deployer)
AUTHORITY_ADDRESS=

# X.509 Subject "O" (organization name) anchored on-chain for the authority (D30).
# Must match the self-signed certificate used by the verifier portal (Phase 9).
AUTHORITY_ORG_NAME="So Tai nguyen va Moi truong TP.HCM"

# -------------------------------------------------------
# Database (PostgreSQL via Docker — host port 5433)
# Port 5433 is used to avoid conflict with other local projects on 5432
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/land_registry?schema=public"

# -------------------------------------------------------
# Frontend (Next.js public env vars — exposed to browser)
# -------------------------------------------------------

# Deployed RootRegistry contract address (fill after deploy)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# WalletConnect Project ID — get from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID
