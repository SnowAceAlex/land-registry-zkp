{
  "name": "@land-registry/backend",
  "version": "0.1.0",
  "description": "NestJS backend: LUR records CRUD, Merkle proof API, chain interaction",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/web-app/backend/src/main",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "jest",
    "cert:generate": "ts-node scripts/generate-issuer-cert.ts",
    "seed:admin-units": "ts-node scripts/seed-admin-units.ts",
    "openapi:export": "node scripts/export-openapi.js"
  },
  "dependencies": {
    "@land-registry/blockchain": "workspace:*",
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^8.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.0.0",
    "archiver": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^6.12.1",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "dejavu-fonts-ttf": "^2.37.3",
    "jest": "^29.7.0",
    "prisma": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@land-registry/blockchain/shared$": "<rootDir>/../../blockchain/shared/index.ts",
      "^@land-registry/blockchain/typechain-types$": "<rootDir>/../../blockchain/typechain-types/index.ts"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    }
  }
}
