// Prisma schema — synced with CODING_ROADMAP.md D19 (leaf schema) + D3 (off-chain
// metadata) + Phase 5 additions (MerkleRoot, TransferRequest) + Phase 7 UC-flow
// realignment (D42-D48: ChangeSet, Revocation, PropertyEvent;
// IssuedBundle dropped — see docs/superpowers/specs/2026-09-07-uc-flow-realignment-design.md).
//
// Connection URL lives in prisma.config.ts (Prisma 7 pattern), NOT here.
// Default: postgresql://postgres:postgres@localhost:5433/land_registry?schema=public

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums are stored by NAME (readable in DB). The name↔numeric mapping used for
// circuit inputs lives in src/records/record.mapper.ts, backed by the enums in
// @land-registry/blockchain/shared — never map numbers by hand elsewhere.

enum UseType {
  RESIDENTIAL
  AGRICULTURAL
  COMMERCIAL
  INDUSTRIAL
  FORESTRY
}

enum EncumbranceStatus {
  FREE
  MORTGAGED
  LITIGATED
  RESTRICTED
}

enum TenureType {
  PERPETUAL
  FIXED_TERM
  PROJECT_LEASEHOLD
}

enum TransferStatus {
  PENDING
  APPROVED
  PUBLISHED
  REJECTED
}

/// Đối tượng sử dụng đất — mục B Phụ lục II TT 08/2024. Off-chain only (D3),
/// but it decides which tenures are lawful for a given land code (Điều 171).
enum LandUserType {
  /// Cá nhân trong nước
  CNV
  /// Cộng đồng dân cư
  CDS
  /// Tổ chức kinh tế
  TKT
  /// Cơ quan nhà nước, cơ quan Đảng, đơn vị vũ trang nhân dân
  TCN
  /// Tổ chức sự nghiệp công lập
  TSN
}

/// Lifecycle of a property record. Replaces the old implicit rule
/// "ownerCommitment != null means issued": a REVOKED property still has a
/// commitment, so that rule could not express the third state (D45).
enum PropertyStatus {
  /// Imported from CSV, no owner secret generated yet
  IMPORTED
  /// Issued and present in the Merkle tree
  ISSUED
  /// Revoked — leaf removed from the tree, proofs no longer producible
  REVOKED
}

/// Lifecycle of a ChangeSet draft (D43): DRAFT → PUBLISHED or DISCARDED.
enum DraftStatus {
  DRAFT
  PUBLISHED
  DISCARDED
}

enum RevocationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum PropertyEventKind {
  ISSUED
  TRANSFERRED
  REVOKED
  ENCUMBRANCE_CHANGED
  VALIDITY_CHANGED
}

// ─────────────────────────────────────────────────────────────────────────────
// Property — one Land Use Rights (LUR) record
// ─────────────────────────────────────────────────────────────────────────────
// The 6 on-chain leaf fields (D4 order: propertyId, ownerCommitment, useType,
// validityPeriod, encumbranceStatus, tenureType) + off-chain-only metadata
// (D3/D19) that never enters the leaf hash.

model Property {
  id Int @id @default(autoincrement())

  /// Decimal string of a bigint — unique public identifier, part of the leaf
  propertyId String @unique

  /// Poseidon([ownerSecret]) as decimal string. NULL = imported but not yet
  /// issued (D14: the secret — and therefore the commitment — is generated at
  /// issue time, never before, never stored).
  ownerCommitment String?

  useType           UseType
  /// Unix seconds (decimal string); "0" sentinel when tenureType = PERPETUAL (D5)
  validityPeriod    String
  encumbranceStatus EncumbranceStatus
  /// Supplied by the import and validated against landUseCode + landUserType
  /// (revised D2 — the term follows how the State granted the land, not the
  /// land category alone; see Điều 171 Luật Đất đai 2024).
  tenureType        TenureType

  // Off-chain-only metadata (D3/D19) — displayed in UI/PDF, never hashed
  landUseCode          String
  /// Đối tượng sử dụng đất; null = cá nhân (the ordinary case)
  landUserType         LandUserType?
  /// Đất cộng đồng dùng để bảo tồn bản sắc dân tộc (Điều 178 khoản 4) — the
  /// condition that makes community land perpetual; community use alone is not
  culturalPreservation Boolean       @default(false)
  certificateSerial    String
  bookEntryNumber      String
  /// Số tờ bản đồ — mandatory on a real GCN (mẫu TT 10/2024)
  mapSheetNumber       String?
  /// Nguồn gốc sử dụng đất — mandatory on a real GCN (Nhà nước giao/cho thuê/công nhận)
  landOrigin           String?
  address              String
  area                 Decimal       @db.Decimal(12, 2)
  issuingAuthority     String
  issueDate            DateTime      @db.Date

  // Written when this plot's leaf changes (non-sensitive — safe to store).
  // The Merkle PROOF is no longer cached here: since D72 the tree itself lives
  // in `merkle_nodes`, and a proof is TREE_DEPTH key lookups away.
  /// Poseidon leaf hash, decimal string
  leaf        String?
  /// Root version in which this leaf last changed (D72). No longer a staleness
  /// flag for a cached proof — there is no cached proof. Written by confirm(),
  /// and only for the plots that round actually changed.
  rootVersion Int?
  /// When the owner bundle was issued; NULL = not yet issued
  issuedAt    DateTime?

  /// Lifecycle state. The tree contains exactly the ISSUED rows.
  status PropertyStatus @default(IMPORTED)

  /// Land office whose area this plot lies in (D85); null until assigned
  landOfficeId Int?
  landOffice   LandOffice? @relation(fields: [landOfficeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tree membership is `status === ISSUED` (D45), so every tree load filters on
  /// it. Without this index that filter is a sequential scan over the whole
  /// cadastre.
  @@index([status])
  @@index([landOfficeId, status])
  @@map("properties")
}

// ─────────────────────────────────────────────────────────────────────────────
// AdministrativeUnit — commune-level catalog (phường / xã / đặc khu)
// ─────────────────────────────────────────────────────────────────────────────
// Reference data, not application logic: the two-tier structure in force since
// 01/7/2025 (NĐ 151/2025) means an address resolves to exactly one of these.
// Kept in the database rather than in code so the catalog can be re-seeded from
// an official export without a redeploy.
//
// Seed it with: pnpm --filter backend run seed:admin-units <file>
// While the table is EMPTY the importer cannot verify that a ward exists, and
// says so instead of silently accepting anything.

enum AdministrativeUnitType {
  PHUONG
  XA
  DAC_KHU
}

model AdministrativeUnit {
  id        Int                    @id @default(autoincrement())
  /// Name without the "Phường"/"Xã" prefix, e.g. "Sài Gòn"
  name      String
  type      AdministrativeUnitType
  /// Tỉnh / thành phố trực thuộc trung ương
  province  String
  /// Official code from the source export, when the file carries one
  code      String?
  createdAt DateTime               @default(now())

  /// Land office responsible for this commune (D85)
  landOfficeId Int?
  landOffice   LandOffice? @relation(fields: [landOfficeId], references: [id])

  @@unique([name, province])
  @@index([province])
  @@index([landOfficeId])
  @@map("administrative_units")
}

// ─────────────────────────────────────────────────────────────────────────────
// LandOffice — the offices that operate the registry (D85)
// ─────────────────────────────────────────────────────────────────────────────
// The office-stamp columns on the procedure tables (officeId, approvedByOfficeId,
// createdByOfficeId, confirmedByOfficeId, firstDownloadedByOfficeId and landOfficeId
// on TransferRequest/Revocation/IssuanceRequest) are plain Int audit stamps with
// no Prisma relation: each relation would need its own named back-relation here.

enum LandOfficeKind {
  HEAD_OFFICE
  SITE
  BRANCH
}

model LandOffice {
  id          Int                  @id @default(autoincrement())
  /// HQ | CS2 | CS3 | CN01…CN38
  code        String               @unique
  name        String
  kind        LandOfficeKind
  units       AdministrativeUnit[]
  properties  Property[]
  credentials OfficeCredential[]
  archives    ChangeSetArchive[]
  createdAt   DateTime             @default(now())

  @@map("land_offices")
}

model OfficeCredential {
  id        Int        @id @default(autoincrement())
  officeId  Int
  office    LandOffice @relation(fields: [officeId], references: [id])
  /// sha256(key), hex
  keyHash   String     @unique
  createdAt DateTime   @default(now())
  revokedAt DateTime?

  @@index([officeId])
  @@map("office_credentials")
}

// ─────────────────────────────────────────────────────────────────────────────
// MerkleRoot — mirror of on-chain rootHistory (D29)
// ─────────────────────────────────────────────────────────────────────────────

model MerkleRoot {
  id          Int      @id @default(autoincrement())
  /// On-chain rootVersion (starts at 1)
  version     Int      @unique
  /// Decimal string. NOT unique — the contract allows re-publishing an old
  /// root as a new version.
  root        String
  /// publishRoot() transaction hash
  txHash      String
  publishedAt DateTime @default(now())

  @@map("merkle_roots")
}

// ─────────────────────────────────────────────────────────────────────────────
// MerkleNode — the sparse tree, stored (D72)
// ─────────────────────────────────────────────────────────────────────────────
// OCCUPIED nodes of the fixed-depth sparse tree (D20/D41). A missing row means
// "empty subtree" and is answered from zeroHashes[height] — the same chain
// buildTree() uses. height 0 = leaf (index = propertyId, D41),
// height TREE_DEPTH = root.
//
// `index` tops out at 2^24 − 1 = 16,777,215, comfortably inside Int (2^31 − 1).
//
// Machine-only: no endpoint returns this table in any form. At 2.5M scattered
// leaves it is roughly 10M rows / ~1.5 GB including the primary key.

model MerkleNode {
  height Int
  index  Int
  /// Poseidon hash, decimal string — same convention as every other hash column
  hash   String

  @@id([height, index])
  @@map("merkle_nodes")
}

// ─────────────────────────────────────────────────────────────────────────────
// ChangeSet — one registration round: issuances + transfers + revocations (D84)
// ─────────────────────────────────────────────────────────────────────────────

model ChangeSet {
  id     Int         @id @default(autoincrement())
  status DraftStatus @default(DRAFT)

  newRoot     String
  rootVersion Int?
  txHash      String?

  transfers   TransferRequest[]
  revocations Revocation[]
  issuances   IssuanceRequest[]
  archives    ChangeSetArchive[]

  /// Offices that drafted / confirmed the round (plain stamps, no relation)
  createdByOfficeId   Int?
  confirmedByOfficeId Int?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status])
  @@map("change_sets")
}

/// One archive per (change set, office): each office downloads only its own plots' bundles (D88).
model ChangeSetArchive {
  id                        Int        @id @default(autoincrement())
  changeSetId               Int
  changeSet                 ChangeSet  @relation(fields: [changeSetId], references: [id])
  officeId                  Int
  office                    LandOffice @relation(fields: [officeId], references: [id])
  /// null once expired and purged
  zip                       Bytes?
  propertyCount             Int
  expiresAt                 DateTime
  firstDownloadedAt         DateTime?
  firstDownloadedByOfficeId Int?

  @@unique([changeSetId, officeId])
  @@index([officeId])
  @@map("change_set_archives")
}

enum IssuanceRequestStatus {
  READY
  PUBLISHED
  WITHDRAWN
}

/// A pending issuance: the owner secret is held until the change set archive is written (D87).
model IssuanceRequest {
  id              Int                   @id @default(autoincrement())
  propertyId      String
  ownerSecret     String?
  ownerCommitment String
  status          IssuanceRequestStatus @default(READY)
  /// office that acted (always central for issuance)
  officeId        Int
  /// copy of Property.landOfficeId at creation
  landOfficeId    Int?
  heldAt          DateTime?
  heldReason      String?
  changeSetId     Int?
  changeSet       ChangeSet?            @relation(fields: [changeSetId], references: [id])
  createdAt       DateTime              @default(now())
  publishedAt     DateTime?

  @@index([status])
  @@index([propertyId])
  @@index([landOfficeId, status])
  @@map("issuance_requests")
}

/// successor replaces predecessor (D90). Written at import only.
model PropertyLineage {
  predecessorPropertyId String
  successorPropertyId   String
  createdAt             DateTime @default(now())

  @@id([predecessorPropertyId, successorPropertyId])
  @@index([successorPropertyId])
  @@map("property_lineage")
}

// ─────────────────────────────────────────────────────────────────────────────
// Revocation — a request to revoke a certificate (D45)
// ─────────────────────────────────────────────────────────────────────────────

model Revocation {
  id         Int    @id @default(autoincrement())
  propertyId String

  /// 1=state reclamation, 2=issued in error, 3=dispute/court, 4=expired, 5=other
  reasonCode Int
  /// Free text, stays off-chain
  detailText String
  /// keccak256(detailText), 0x-prefixed hex — this is what goes on-chain
  detailHash String

  status      RevocationStatus @default(PENDING)
  changeSetId Int?
  changeSet   ChangeSet?       @relation(fields: [changeSetId], references: [id])

  /// Office that filed it / office owning the plot's area (plain stamps, no relation)
  officeId     Int
  landOfficeId Int?
  /// Set while an officer holds it out of the next change set
  heldAt       DateTime?
  heldReason   String?

  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status])
  @@index([propertyId])
  @@index([landOfficeId, status])
  @@map("revocations")
}

// ─────────────────────────────────────────────────────────────────────────────
// PropertyEvent — per-plot history (D48)
// ─────────────────────────────────────────────────────────────────────────────
// Read publicly and unguarded, on the same reasoning as D39: every field here is
// either a pseudonymous commitment (D8) or a Poseidon hash.

model PropertyEvent {
  id         Int               @id @default(autoincrement())
  propertyId String
  kind       PropertyEventKind

  /// Root version this change took effect in; null while not yet published
  rootVersion Int?
  txHash      String?

  previousOwnerCommitment String?
  newOwnerCommitment      String?
  previousLeaf            String?
  newLeaf                 String?

  /// Kind-specific extras: reasonCode + reason text, encumbrance from→to, …
  detail Json?

  occurredAt DateTime @default(now())

  @@index([propertyId, occurredAt])
  @@map("property_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// TransferRequest — D28 pending-approval queue
// ─────────────────────────────────────────────────────────────────────────────

model TransferRequest {
  id                 Int            @id @default(autoincrement())
  propertyId         String
  /// Poseidon([newOwnerSecret]) as decimal string
  newOwnerCommitment String
  /// Buyer's secret, decimal string (D77). Set at submit, cleared in the same
  /// transaction that writes the change set's archive, or on reject. Never
  /// serialised — see transfers/transfer-request.serializer.ts.
  newOwnerSecret     String?
  /// publicSignals[0] — root the proof was generated against
  oldRoot            String
  /// publicSignals[1] — projected root to publish on approval
  newRoot            String
  /// Groth16Proof JSON as emitted by snarkjs
  proof              Json
  /// string[7] in PUBLIC_SIGNAL_ORDER.transfer (D21)
  publicSignals      Json
  status             TransferStatus @default(PENDING)
  rejectReason       String?
  /// publishRoot() tx hash once approved
  txHash             String?
  createdAt          DateTime       @default(now())
  decidedAt          DateTime?

  changeSetId Int?
  changeSet   ChangeSet? @relation(fields: [changeSetId], references: [id])

  /// Office that filed it / office that approved it / office owning the plot's
  /// area (plain stamps, no relation)
  officeId           Int
  approvedByOfficeId Int?
  landOfficeId       Int?
  /// Set while an officer holds it out of the next change set
  heldAt             DateTime?
  heldReason         String?

  @@index([landOfficeId, status])
  @@map("transfer_requests")
}
