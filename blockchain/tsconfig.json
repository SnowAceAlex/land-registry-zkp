{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["./hardhat.config.ts", "./scripts/**/*", "./test/**/*", "./shared/**/*"],
  "exclude": ["node_modules", "dist", "artifacts", "cache"],
  "ts-node": {
    "files": true
  }
}
